# Environment files
.env
.env.*
*.env

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE / editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage reports
coverage/

# Temporary files
.tmp/
*.local

# Misc
*.tgz
*.zip

