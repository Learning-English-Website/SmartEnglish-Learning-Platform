	"item": [
		{
			"name": "UC01 - Đăng ký tài khoản",
			"item": [
				{
					"name": "01. Đăng ký tài khoản mới",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const uniqueVal = Date.now();",
									"pm.environment.set(\"test_email\", \"postman\" + uniqueVal + \"@example.com\");",
									"pm.environment.set(\"test_username\", \"postman\" + uniqueVal);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Đăng ký thành công - Status 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.test(\"Yêu cầu xác thực OTP\", function () {",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data.requiresEmailVerification).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{test_email}}\",\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{API_BASE_URL}}/auth/register",
							"host": [
								"{{API_BASE_URL}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "02. Lấy OTP xác thực (Dev-Only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Lấy OTP từ Redis thành công\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.otp) {",
									"    pm.environment.set(\"otp\", jsonData.otp);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{API_BASE_URL}}/auth/dev-get-otp?email={{test_email}}",
							"host": [
								"{{API_BASE_URL}}"
							],
							"path": [
								"auth",
								"dev-get-otp"
							],
							"query": [
								{
									"key": "email",
									"value": "{{test_email}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "03. Xác thực OTP email",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Xác thực OTP thành công - Status 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
